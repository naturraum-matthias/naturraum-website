---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  titel="Über mich"
  beschreibung="Matthias — zertifizierter Permakultur-Designer, Agroforst-Berater und Wildnispädagoge mit über 20 Jahren Erfahrung."
>

  <!-- Seiten-Hero -->
  <section class="seiten-hero">
    <div class="seiten-hero__bild-wrapper">
      <img src="/bilder/Waldgärten/Waldrand, Waldgarten Ahaus.JPG" alt="Waldrand" />
      <div class="seiten-hero__overlay"></div>
    </div>
    <div class="container seiten-hero__inhalt">
      <p class="seiten-hero__label">Über mich</p>
      <h1>Natur als Lebensthema</h1>
    </div>
  </section>

  <!-- Intro -->
  <section class="sektion">
    <div class="container ueber-intro">
      <div class="ueber-intro__bild">
        <img
          src="/bilder/Waldgärten/Lichtung, Waldgarten Ahaus.jpg"
          alt="Im Waldgarten"
        />
      </div>
      <div class="ueber-intro__text">
        <h2>Mein Weg zur Permakultur</h2>
        <div class="trennlinie" style="margin: 1rem 0;"></div>
        <p>
          Seit über 20 Jahren beschäftige ich mich intensiv mit Permakultur, Agroforst und
          essbaren Wildpflanzen — nicht nur theoretisch, sondern vor allem praktisch in meinem
          eigenen Waldgarten in Ahaus, den ich seit 2008 aufgebaut und dokumentiert habe.
        </p>
        <p>
          Als ausgebildeter Lehrer und Tischler bringe ich handwerkliches und pädagogisches Know-how
          in meine Arbeit ein. Das verbindende Thema hinter allem ist die <strong>essbare Landschaft</strong> —
          Räume, die Menschen und Natur gleichermaßen nähren.
        </p>
        <p>
          Ich arbeite mit Landwirten, Gartenprojekten, Solidarischen Landwirtschaften und
          Kommunen zusammen — immer mit dem Ziel, nachhaltige und produktive Naturräume zu gestalten.
        </p>
      </div>
    </div>
  </section>

  <!-- Zertifikate -->
  <section class="sektion sektion--hell">
    <div class="container">
      <div class="abschnitt-kopf">
        <h2>Qualifikationen & Zertifikate</h2>
        <div class="trennlinie"></div>
      </div>
      <div class="zertifikate-grid">
        <div class="zertifikat-karte">
          <div class="zertifikat-karte__icon">🌿</div>
          <h4>PDC nach Jeff Lawton</h4>
          <p>Permaculture Design Certificate — international anerkannte Permakultur-Ausbildung</p>
        </div>
        <div class="zertifikat-karte">
          <div class="zertifikat-karte__icon">🌳</div>
          <h4>Agroforst nach DeFAF</h4>
          <p>Zertifizierter Agroforst-Berater nach den Standards des Deutschen Fachverbands für Agroforstwirtschaft</p>
        </div>
        <div class="zertifikat-karte">
          <div class="zertifikat-karte__icon">🌱</div>
          <h4>Coach für Essbare Wildpflanzen</h4>
          <p>Zertifizierter Coach für Essbare Wildpflanzen</p>
          <img src="/bilder/allgemein/zertifikat-wildpflanzen.png" alt="Zertifikat Wildpflanzen-Coach" class="zertifikat-karte__logo" />
        </div>
        <div class="zertifikat-karte">
          <div class="zertifikat-karte__icon">🦅</div>
          <h4>Wildnispädagogik</h4>
          <p>Ausgebildeter Wildnispädagoge — Naturverbindung, Spuren lesen, Survival</p>
        </div>
        <div class="zertifikat-karte">
          <div class="zertifikat-karte__icon">🍎</div>
          <h4>Baumwart in Ausbildung</h4>
          <p>Ausbildung zum zertifizierten Obstbaumwart — Schnitt, Pflege, Obstwiesen</p>
        </div>
        <div class="zertifikat-karte">
          <div class="zertifikat-karte__icon">📚</div>
          <h4>20 Jahre Lehrerfahrung</h4>
          <p>Ausgebildeter Lehrer mit zwei Jahrzehnten Erfahrung in Wissensvermittlung und Pädagogik</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Waldgarten-Zeitreihe -->
  <section class="sektion">
    <div class="container">
      <div class="abschnitt-kopf">
        <h2>Mein Waldgarten — 15 Jahre Entwicklung</h2>
        <div class="trennlinie"></div>
        <p>Von der Wiese zum artenreichen essbaren Wald — eine Dokumentation in Bildern</p>
      </div>
      <div class="zeitreihe">
        <div class="zeitreihe__eintrag">
          <div class="zeitreihe__jahr">2008</div>
          <div class="zeitreihe__bild">
            <img src="/bilder/Waldgärten/Entwicklung eines Waldgartens/Waldgarten Ahaus 2008.JPG" alt="Waldgarten 2008" />
          </div>
          <p>Beginn der Planung und erste Pflanzungen</p>
        </div>
        <div class="zeitreihe__eintrag">
          <div class="zeitreihe__jahr">2010</div>
          <div class="zeitreihe__bild">
            <img src="/bilder/Waldgärten/Entwicklung eines Waldgartens/Waldgarten Ahaus 2010.JPG" alt="Waldgarten 2010" />
          </div>
          <p>Erste Strukturen entstehen, Gehölze wachsen an</p>
        </div>
        <div class="zeitreihe__eintrag">
          <div class="zeitreihe__jahr">2015</div>
          <div class="zeitreihe__bild">
            <img src="/bilder/Waldgärten/Entwicklung eines Waldgartens/Waldgarten Ahaus 2015.JPG" alt="Waldgarten 2015" />
          </div>
          <p>Waldgarten ist deutlich gereift, mehrere Schichten etabliert</p>
        </div>
        <div class="zeitreihe__eintrag">
          <div class="zeitreihe__jahr">2016+</div>
          <div class="zeitreihe__bild">
            <img src="/bilder/Waldgärten/Entwicklung eines Waldgartens/Waldgarten Ahaus 2016.JPG" alt="Waldgarten 2016" />
          </div>
          <p>Artenreicher, produktiver Waldgarten in voller Entwicklung</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Arbeitsweise -->
  <section class="sektion sektion--hell">
    <div class="container container--schmal">
      <div class="abschnitt-kopf">
        <h2>Meine Arbeitsweise</h2>
        <div class="trennlinie"></div>
      </div>
      <div class="arbeitsweise-liste">
        <div class="arbeitsweise-punkt">
          <div class="arbeitsweise-punkt__nr">01</div>
          <div>
            <h4>Beobachten vor Planen</h4>
            <p>Jeder Ort hat seine eigene Geschichte. Ich nehme mir Zeit, das Gelände zu lesen — Boden, Wasser, Licht, Wind — bevor ich plane.</p>
          </div>
        </div>
        <div class="arbeitsweise-punkt">
          <div class="arbeitsweise-punkt__nr">02</div>
          <div>
            <h4>Ganzheitlich denken</h4>
            <p>Permakultur bedeutet: alle Elemente im System in Beziehung setzen. Pflanze, Tier, Mensch, Wasser und Boden arbeiten zusammen.</p>
          </div>
        </div>
        <div class="arbeitsweise-punkt">
          <div class="arbeitsweise-punkt__nr">03</div>
          <div>
            <h4>Praktisch und bodenständig</h4>
            <p>Als Tischler und Praktiker weiß ich: Schöne Pläne müssen umsetzbar sein. Ich plane so, dass du es auch wirklich umsetzen kannst.</p>
          </div>
        </div>
        <div class="arbeitsweise-punkt">
          <div class="arbeitsweise-punkt__nr">04</div>
          <div>
            <h4>Langfristig begleiten</h4>
            <p>Natur braucht Zeit. Ich bin auch nach der Planung ansprechbar — für Fragen, Anpassungen und Weiterentwicklung.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-banner">
    <div class="container">
      <h2>Neugierig geworden?</h2>
      <p>Lass uns über dein Projekt sprechen.</p>
      <a href="/kontakt" class="btn btn--sekundaer">Kontakt aufnehmen</a>
    </div>
  </section>

</BaseLayout>

<style>
  .seiten-hero {
    position: relative;
    height: 50vh;
    min-height: 350px;
    display: flex;
    align-items: flex-end;
    padding-bottom: 3rem;
    padding-top: 80px;
  }

  .seiten-hero__bild-wrapper {
    position: absolute;
    inset: 0;
  }

  .seiten-hero__bild-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .seiten-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(44,44,44,0.8) 0%, rgba(44,44,44,0.3) 60%);
  }

  .seiten-hero__inhalt {
    position: relative;
    z-index: 1;
    color: white;
  }

  .seiten-hero__label {
    font-size: 0.85rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.75);
    margin-bottom: 0.5rem;
  }

  .seiten-hero__inhalt h1 {
    color: white;
  }

  /* Intro */
  .ueber-intro {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 4rem;
    align-items: center;
  }

  .ueber-intro__bild img {
    width: 100%;
    height: 480px;
    object-fit: cover;
    border-radius: 12px;
    box-shadow: var(--schatten-m);
  }

  /* Zertifikate */
  .zertifikate-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .zertifikat-karte {
    background: white;
    border-radius: 12px;
    padding: 1.8rem;
    box-shadow: var(--schatten-s);
    border-top: 3px solid var(--farbe-rostrot);
  }

  .zertifikat-karte__icon {
    font-size: 2rem;
    margin-bottom: 0.8rem;
  }

  .zertifikat-karte h4 {
    margin-bottom: 0.5rem;
    font-size: 1rem;
  }

  .zertifikat-karte p {
    color: var(--farbe-text-hell);
    font-size: 0.9rem;
  }

  .zertifikat-karte__logo {
    margin-top: 1rem;
    max-height: 60px;
    width: auto;
  }

  /* Zeitreihe */
  .zeitreihe {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .zeitreihe__eintrag {
    text-align: center;
  }

  .zeitreihe__jahr {
    font-family: var(--font-headline);
    font-size: 1.8rem;
    color: var(--farbe-ocker);
    font-weight: 700;
    margin-bottom: 0.75rem;
  }

  .zeitreihe__bild img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    border-radius: 8px;
    margin-bottom: 0.75rem;
  }

  .zeitreihe__eintrag p {
    font-size: 0.9rem;
    color: var(--farbe-text-hell);
  }

  /* Arbeitsweise */
  .arbeitsweise-liste {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .arbeitsweise-punkt {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
  }

  .arbeitsweise-punkt__nr {
    font-family: var(--font-headline);
    font-size: 2.5rem;
    color: rgba(123,94,167,0.2);
    font-weight: 700;
    line-height: 1;
    flex-shrink: 0;
    width: 60px;
  }

  .arbeitsweise-punkt h4 {
    margin-bottom: 0.4rem;
  }

  .arbeitsweise-punkt p {
    color: var(--farbe-text-hell);
  }

  /* CTA Banner */
  .cta-banner {
    background: var(--farbe-dunkeloliv);
    padding: var(--abstand-xl) 0;
    text-align: center;
    color: white;
  }

  .cta-banner h2 { color: white; margin-bottom: 0.75rem; }
  .cta-banner p { color: rgba(255,255,255,0.9); margin-bottom: 1.5rem; }

  @media (max-width: 900px) {
    .ueber-intro { grid-template-columns: 1fr; gap: 2rem; }
    .ueber-intro__bild img { height: 300px; }
    .zertifikate-grid { grid-template-columns: repeat(2, 1fr); }
    .zeitreihe { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 600px) {
    .zertifikate-grid { grid-template-columns: 1fr; }
    .zeitreihe { grid-template-columns: 1fr; }
  }
</style>
