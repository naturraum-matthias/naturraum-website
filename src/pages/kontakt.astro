---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout titel="Kontakt" beschreibung="Kontakt zu NaturRaum — Permakultur-Beratung, Coaching und Kurse anfragen.">

  <section class="seiten-hero">
    <div class="seiten-hero__bild-wrapper">
      <img src="/bilder/Permakultur-Elemente/Gartenarbeitsplatz.JPG" alt="Im Garten arbeiten" />
      <div class="seiten-hero__overlay"></div>
    </div>
    <div class="container seiten-hero__inhalt">
      <p class="seiten-hero__label">Schreib mir</p>
      <h1>Kontakt</h1>
    </div>
  </section>

  <section class="sektion">
    <div class="container kontakt-layout">

      <div class="kontakt-info">
        <h2>Lass uns ins Gespräch kommen</h2>
        <div class="trennlinie" style="margin: 1rem 0;"></div>
        <p>
          Ob du eine Frage hast, ein Projekt besprechen möchtest oder einfach mehr über
          meine Angebote erfahren willst — ich freue mich auf deine Nachricht.
        </p>
        <p>
          Ich antworte in der Regel innerhalb von 2–3 Werktagen.
        </p>

        <div class="kontakt-punkte">
          <div class="kontakt-punkt">
            <div class="kontakt-punkt__icon">🌿</div>
            <div>
              <h4>Beratung & Coaching</h4>
              <p>Für Anfragen zu Permakultur-Beratung, Agroforst-Coaching und Waldgarten-Planung</p>
            </div>
          </div>
          <div class="kontakt-punkt">
            <div class="kontakt-punkt__icon">📅</div>
            <div>
              <h4>Kurse & Workshops</h4>
              <p>Für Kursanmeldungen, Gruppenanfragen und individuelle Workshop-Formate</p>
            </div>
          </div>
          <div class="kontakt-punkt">
            <div class="kontakt-punkt__icon">👥</div>
            <div>
              <h4>TeamTage & Seminare</h4>
              <p>Für Firmen, Vereine und Gruppen, die einen naturverbindenden TeamTag suchen</p>
            </div>
          </div>
        </div>
      </div>

      <div class="kontakt-formular-wrapper">
        <form
          name="kontakt"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-feld"
          class="kontakt-formular"
        >
          <input type="hidden" name="form-name" value="kontakt" />
          <p style="display: none;">
            <label>Nicht ausfüllen: <input name="bot-feld" /></label>
          </p>

          <div class="formular-gruppe">
            <label for="name">Name *</label>
            <input type="text" id="name" name="name" required placeholder="Dein Name" />
          </div>

          <div class="formular-gruppe">
            <label for="email">E-Mail *</label>
            <input type="email" id="email" name="email" required placeholder="deine@email.de" />
          </div>

          <div class="formular-gruppe">
            <label for="betreff">Worum geht es?</label>
            <select id="betreff" name="betreff">
              <option value="">— Bitte wählen —</option>
              <option value="Beratung">Beratung</option>
              <option value="Coaching">Coaching</option>
              <option value="Kurs / Workshop">Kurs / Workshop</option>
              <option value="TeamTag">TeamTag</option>
              <option value="Sonstiges">Sonstiges</option>
            </select>
          </div>

          <div class="formular-gruppe">
            <label for="nachricht">Deine Nachricht *</label>
            <textarea id="nachricht" name="nachricht" required rows="6" placeholder="Erzähl mir von deinem Projekt, deiner Fläche oder deiner Frage ..."></textarea>
          </div>

          <div class="formular-gruppe formular-gruppe--checkbox">
            <label class="checkbox-label">
              <input type="checkbox" name="datenschutz" required />
              <span>Ich habe die <a href="/datenschutz">Datenschutzerklärung</a> gelesen und stimme der Verarbeitung meiner Daten zu. *</span>
            </label>
          </div>

          <button type="submit" class="btn btn--primaer btn--voll">Nachricht absenden</button>
        </form>
      </div>

    </div>
  </section>

</BaseLayout>

<style>
  .seiten-hero {
    position: relative; height: 50vh; min-height: 350px;
    display: flex; align-items: flex-end; padding-bottom: 3rem; padding-top: 80px;
  }
  .seiten-hero__bild-wrapper { position: absolute; inset: 0; }
  .seiten-hero__bild-wrapper img { width: 100%; height: 100%; object-fit: cover; }
  .seiten-hero__overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(44,44,44,0.8) 0%, rgba(44,44,44,0.3) 60%); }
  .seiten-hero__inhalt { position: relative; z-index: 1; color: white; }
  .seiten-hero__label { font-size: 0.85rem; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(255,255,255,0.75); margin-bottom: 0.5rem; }
  .seiten-hero__inhalt h1 { color: white; }

  .kontakt-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: start;
  }

  .kontakt-punkte {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .kontakt-punkt {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .kontakt-punkt__icon {
    font-size: 1.8rem;
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  .kontakt-punkt h4 { margin-bottom: 0.25rem; font-size: 1rem; }
  .kontakt-punkt p { color: var(--farbe-text-hell); font-size: 0.9rem; }

  .kontakt-formular-wrapper {
    background: var(--farbe-hintergrund);
    border-radius: 16px;
    padding: 2.5rem;
  }

  .kontakt-formular {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .formular-gruppe {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .formular-gruppe label {
    font-weight: 500;
    font-size: 0.9rem;
    color: var(--farbe-text);
  }

  .formular-gruppe input,
  .formular-gruppe select,
  .formular-gruppe textarea {
    padding: 0.75rem 1rem;
    border: 1.5px solid var(--farbe-border);
    border-radius: 8px;
    font-family: var(--font-text);
    font-size: 1rem;
    color: var(--farbe-text);
    background: white;
    transition: border-color 0.2s;
    width: 100%;
  }

  .formular-gruppe input:focus,
  .formular-gruppe select:focus,
  .formular-gruppe textarea:focus {
    outline: none;
    border-color: var(--farbe-lila);
  }

  .formular-gruppe textarea {
    resize: vertical;
    min-height: 150px;
  }

  .formular-gruppe--checkbox { margin-top: 0.25rem; }

  .checkbox-label {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    font-size: 0.85rem;
    color: var(--farbe-text-hell);
    font-weight: 400 !important;
    cursor: pointer;
  }

  .checkbox-label input {
    width: auto;
    margin-top: 0.15rem;
    flex-shrink: 0;
  }

  .checkbox-label a { color: var(--farbe-oliv); text-decoration: underline; }

  .btn--voll { width: 100%; justify-content: center; }

  @media (max-width: 900px) {
    .kontakt-layout { grid-template-columns: 1fr; gap: 3rem; }
  }
</style>
