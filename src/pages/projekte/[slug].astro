---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projekte = await getCollection('projekte');
  return projekte.map(projekt => ({
    params: { slug: projekt.id },
    props: { projekt },
  }));
}

const { projekt } = Astro.props;
const { Content } = await render(projekt);
---

<BaseLayout
  titel={projekt.data.titel}
  beschreibung={`Permakultur-Projekt: ${projekt.data.titel}${projekt.data.ort ? ` in ${projekt.data.ort}` : ''}`}
>

  <section class="seiten-hero">
    {projekt.data.titelbild ? (
      <div class="seiten-hero__bild-wrapper">
        <img src={`/bilder/projekte/${projekt.data.titelbild}`} alt={projekt.data.titel} />
        <div class="seiten-hero__overlay"></div>
      </div>
    ) : (
      <div class="seiten-hero__bild-wrapper seiten-hero__bild-wrapper--gradient"></div>
    )}
    <div class="container seiten-hero__inhalt">
      <a href="/projekte" class="zurueck-link">← Alle Projekte</a>
      <div class="seiten-hero__meta">
        <span class="badge badge--hell">{projekt.data.kategorie}</span>
        {projekt.data.jahr && <span class="badge badge--hell">{projekt.data.jahr}</span>}
        {projekt.data.ort && <span class="badge badge--hell">📍 {projekt.data.ort}</span>}
      </div>
      <h1>{projekt.data.titel}</h1>
    </div>
  </section>

  <section class="sektion">
    <div class="container inhalt-layout">
      <article class="projekt-inhalt">
        <Content />
      </article>

      {projekt.data.bilder && projekt.data.bilder.length > 0 && (
        <aside class="projekt-galerie">
          <h3>Fotogalerie</h3>
          <div class="galerie">
            {projekt.data.bilder.map(bild => (
              <img src={`/bilder/projekte/${bild}`} alt={projekt.data.titel} />
            ))}
          </div>
        </aside>
      )}
    </div>
  </section>

  <section class="cta-banner">
    <div class="container">
      <h2>Ähnliches Projekt geplant?</h2>
      <p>Ich freue mich auf deine Anfrage.</p>
      <a href="/kontakt" class="btn btn--sekundaer">Kontakt aufnehmen</a>
    </div>
  </section>

</BaseLayout>

<style>
  .seiten-hero {
    position: relative; height: 55vh; min-height: 400px;
    display: flex; align-items: flex-end; padding-bottom: 3rem; padding-top: 80px;
  }
  .seiten-hero__bild-wrapper { position: absolute; inset: 0; }
  .seiten-hero__bild-wrapper img { width: 100%; height: 100%; object-fit: cover; }
  .seiten-hero__bild-wrapper--gradient { background: var(--farbe-dunkeloliv); }
  .seiten-hero__overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(44,44,44,0.85) 0%, rgba(44,44,44,0.3) 60%); }
  .seiten-hero__inhalt { position: relative; z-index: 1; color: white; }
  .seiten-hero__inhalt h1 { color: white; }

  .zurueck-link {
    display: inline-block;
    color: rgba(255,255,255,0.75);
    font-size: 0.9rem;
    margin-bottom: 1rem;
    transition: color 0.2s;
  }

  .zurueck-link:hover { color: white; }

  .seiten-hero__meta {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.75rem;
  }

  .badge--hell {
    background: rgba(255,255,255,0.2);
    color: white;
    border-color: rgba(255,255,255,0.4);
    border-radius: 20px;
    padding: 0.25rem 0.75rem;
    font-size: 0.8rem;
    font-weight: 500;
    display: inline-block;
  }

  .inhalt-layout {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 4rem;
    align-items: start;
  }

  .projekt-inhalt :global(h2) {
    font-family: var(--font-headline);
    font-size: 1.6rem;
    margin: 2rem 0 0.75rem;
  }

  .projekt-inhalt :global(h3) {
    font-family: var(--font-headline);
    font-size: 1.2rem;
    margin: 1.5rem 0 0.5rem;
  }

  .projekt-inhalt :global(p) {
    color: var(--farbe-text);
    margin-bottom: 1rem;
    line-height: 1.7;
  }

  .projekt-inhalt :global(ul) {
    margin: 0.5rem 0 1rem 1.5rem;
    color: var(--farbe-text-hell);
  }

  .projekt-inhalt :global(li) {
    margin-bottom: 0.4rem;
    line-height: 1.6;
  }

  .projekt-galerie h3 {
    margin-bottom: 1rem;
    font-size: 1.1rem;
  }

  .galerie {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    position: sticky;
    top: 100px;
  }

  .galerie img {
    width: 100%;
    border-radius: 8px;
    box-shadow: var(--schatten-s);
  }

  .cta-banner {
    background: var(--farbe-dunkeloliv);
    padding: var(--abstand-xl) 0;
    text-align: center;
    color: white;
  }
  .cta-banner h2 { color: white; margin-bottom: 0.75rem; }
  .cta-banner p { color: rgba(255,255,255,0.9); margin-bottom: 1.5rem; }

  @media (max-width: 900px) {
    .inhalt-layout { grid-template-columns: 1fr; }
    .galerie { position: static; flex-direction: row; flex-wrap: wrap; }
    .galerie img { width: calc(50% - 0.375rem); }
  }
</style>
